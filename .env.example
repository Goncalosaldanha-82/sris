ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_JWT_SECRET=replace-with-a-long-random-secret
ATLAS_ACCESS_TOKEN_MINUTES=60
ATLAS_REPOSITORY_ROOT=.
ATLAS_ENV=development

# Mission Intelligence always runs its deterministic engine. AI is an optional,
# authenticated advisory layer and remains disabled until both settings are present.
SRIS_AI_ENABLED=false
SRIS_AI_MODEL=gpt-5.6
# OPENAI_API_KEY=set-in-the-deployment-secret-store
