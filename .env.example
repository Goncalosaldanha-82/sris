# The canonical service accepts ATLAS_DATABASE_URL or Railway's DATABASE_URL.
# Managed deployments refuse container-local SQLite. Their canonical tables are
# isolated from any legacy public schema under sris_atlas by default.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# ATLAS_DATABASE_SCHEMA=sris_atlas
ATLAS_JWT_SECRET=replace-with-a-long-random-secret
ATLAS_ACCESS_TOKEN_MINUTES=60
ATLAS_REPOSITORY_ROOT=.
ATLAS_ENV=development
# Keep both closed in every managed environment. Establish the first owner
# through docs/SRIS-INSTITUTIONAL-ACCESS-ACTIVATION.md; ordinary accounts then
# enter by invitation. Local developers may enable them only in an isolated DB.
ATLAS_SELF_REGISTRATION_ENABLED=false
ATLAS_ORGANIZATION_CREATION_ENABLED=false
# Temporary first-owner gate. Its private value remains in the deployment; the
# browser receives only a derived, single-use code through the privileged log.
# SRIS_ACCESS_ACTIVATION_EMAIL=owner@example.com
# SRIS_ACCESS_ACTIVATION_TOKEN=set-in-the-deployment-secret-store

# Invite-only accounts and self-service password recovery. In Railway, use the
# exact public URL of the environment being configured; never point staging at
# production or production at staging.
SRIS_PUBLIC_BASE_URL=http://localhost:8000
SRIS_INVITATION_TTL_HOURS=72
SRIS_PASSWORD_RESET_TTL_MINUTES=30
SRIS_PASSWORD_RESET_COOLDOWN_SECONDS=60
# SRIS_SMTP_HOST=smtp.example.com
# SRIS_SMTP_PORT=587
# SRIS_SMTP_SECURITY=starttls
# SRIS_SMTP_USERNAME=set-in-the-deployment-secret-store
# SRIS_SMTP_PASSWORD=set-in-the-deployment-secret-store
# SRIS_SMTP_FROM_EMAIL=access@example.com
# SRIS_SMTP_FROM_NAME=SRIS

# Mission Intelligence always runs its deterministic engine. AI is an optional,
# authenticated advisory layer and remains disabled until both settings are present.
SRIS_AI_ENABLED=false
SRIS_AI_MODEL=gpt-5.6
# Mandatory in Railway/production. Only this exact organization UUID may use AI.
# SRIS_AI_PILOT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# Standard pricing multiplier: 10000 = 1.00x; use 11000 for a 10% uplift.
SRIS_AI_PRICE_MULTIPLIER_BPS=10000
SRIS_AI_RESERVATION_TTL_MINUTES=10
# OPENAI_API_KEY=set-in-the-deployment-secret-store
